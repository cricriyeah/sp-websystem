# Copia este archivo a backend/.env y pega tus llaves. `.env` esta en .gitignore.
# Todo lo de aqui es opcional en local: sin llaves, el backend arranca igual y
# responde 503 en los flujos que las necesitan (ver backend/CLAUDE.md).

# Stripe — cuenta estandar, NO Connect (ver docs/contexto-negocio.md).
# Las de prueba salen de https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# La imprime `stripe listen --forward-to localhost:8000/api/stripe/webhook/`
STRIPE_WEBHOOK_SECRET=whsec_...

# Confirmacion por correo (Resend). Sin esto no se manda correo y el cobro sigue igual.
RESEND_API_KEY=
RESEND_FROM=reservas@tudominio.com

# Confirmacion por WhatsApp (WhatsApp Business API de Meta). La plantilla debe
# estar aprobada y recibir 4 parametros: nombre, fecha, hora, personas.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=reserva_confirmada
WHATSAPP_TEMPLATE_LANG=es_MX

# Gate anti-bot del checkout (Cloudflare Turnstile). Sin esta variable la
# verificacion es un no-op y el checkout funciona igual — en local no hace falta.
# La saca el dashboard de Cloudflare junto con la site key del frontend.
TURNSTILE_SECRET_KEY=

# Duracion de la sesion del backoffice en segundos. Por defecto 36000 (10 horas).
SESSION_COOKIE_AGE=
