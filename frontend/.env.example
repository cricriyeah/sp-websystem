# Copia este archivo a frontend/.env.local para desarrollo. `.env.local` esta en
# .gitignore. En produccion estas mismas variables se capturan en Vercel.
#
# TODAS empiezan con NEXT_PUBLIC_, y eso tiene dos consecuencias que hay que
# tener presentes:
#
# 1. **Se quedan grabadas en el build**, no se leen al arrancar. Cambiar una en
#    Vercel no surte efecto hasta volver a desplegar. Si el sitio sigue apuntando
#    al backend viejo despues de corregir la variable, falta el redeploy.
# 2. **Viajan al navegador en texto claro.** Aqui no va ningun secreto: la llave
#    secreta de Stripe vive solo en el backend y la publicable la sirve el propio
#    backend en la respuesta de crear-pago, no una variable de aqui.

# URL del backend Django. En produccion, la del servicio de Render.
# Sin esto se asume http://localhost:8000 y el checkout no encuentra la API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL publica del sitio. La usan los canonicals, el hreflang, el sitemap y la
# imagen de Open Graph. En produccion tiene que ser el dominio real, o los
# buscadores y las vistas previas de WhatsApp van a apuntar a localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numero de WhatsApp que se publica en la barra superior, en digitos con lada de
# pais y sin signos ni espacios. Sin esta variable el bloque de WhatsApp
# simplemente no se muestra — no rompe nada, pero se pierde el canal de contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=5216120000000

# Site key publica de Cloudflare Turnstile (la privada va en el backend). Sin
# ella el widget no se pinta y el checkout funciona igual.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
