{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node tests/run-hub-tests.cjs",
    "guardia": "node scripts/guardia-estilos.cjs",
    "knip": "knip",
    "test:guardia": "node --test tests/guardia-estilos.test.cjs",
    "test:contraste": "node --test tests/contraste.test.cjs",
    "test:fotos": "node --test tests/imagenes-catalogo-completo.test.cjs",
    "test:contenido": "node --test tests/contenido-paridad.test.cjs tests/claves-huerfanas.test.cjs",
    "verificar": "tsc --noEmit && eslint src tests && npm test && npm run test:contraste && npm run test:contenido && npm run test:guardia && npm run guardia && knip && next build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "knip": "^6.42.1",
    "typescript": "^5"
  }
}
